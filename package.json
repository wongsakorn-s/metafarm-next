{
  "name": "metafarm-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "bun --env-file=.dev.vars scripts/verify-development-db.ts && wrangler dev --port 8787",
    "dev:api:r2": "bun --env-file=.dev.vars scripts/verify-development-db.ts && wrangler dev --env development --port 8787",
    "build": "bun scripts/build-images.ts && vite build && bun scripts/prerender-public.tsx",
    "preview": "bun --env-file=.dev.vars scripts/verify-development-db.ts && wrangler dev --port 4173",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:local": "bun --env-file=.dev.vars scripts/smoke-local.ts",
    "backup:dev": "bun --env-file=.dev.vars scripts/backup.ts",
    "restore:dev": "bun --env-file=.dev.vars scripts/restore.ts",
    "gen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "bun --env-file=.dev.vars scripts/verify-development-db.ts && bun --env-file=.dev.vars run db:migrate",
    "deploy": "echo \"Deploy ผ่าน GitHub Actions (Deploy staging / Deploy production) เท่านั้น เพื่อให้ผ่านตัวตรวจเป้าหมายและ migration\" && exit 1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "jsqr": "^1.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/noto-sans-thai-looped": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
