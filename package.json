{
  "name": "metafarm-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "bun --env-file=.dev.vars scripts/verify-development-db.ts && wrangler dev --port 8787",
    "build": "bun scripts/build-images.ts && vite build && bun scripts/prerender-public.tsx",
    "preview": "bun --env-file=.dev.vars scripts/verify-development-db.ts && wrangler dev --port 4173",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:local": "bun --env-file=.dev.vars scripts/smoke-local.ts",
    "gen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:local": "bun --env-file=.dev.vars scripts/verify-development-db.ts && bun --env-file=.dev.vars run db:migrate",
    "deploy": "bun run check && bun run test && bun run build && wrangler deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "jsqr": "^1.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-thai-looped": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.97.0"
  }
}
